<script>
import geolocation from '@system.geolocation'
import brightness from '@system.brightness'
import file from '@system.file'
import storage from '@system.storage'
import interconnect from '@system.interconnect'
import { createSession } from './common/session'
import { createAppClock } from './common/app-clock'
import { createTrackSync } from './common/track-sync'

export default {
  onCreate() {
    this.clock = createAppClock()
    this.session = createSession({ geolocation, brightness, file, storage }, this.clock)
    this.trackSync = createTrackSync(interconnect, file, this.session, this.clock)
    this.trackSync.start()
  },
  onShow() {
    if (this.session) this.session.resume()
  },
  onHide() {
    if (this.session) this.session.suspend()
  },
  onDestroy() {
    if (this.trackSync) this.trackSync.dispose()
    if (this.session) this.session.dispose()
    if (this.clock) this.clock.dispose()
  }
}
</script>
