<template>
  <div class="page {{pageClass}}">
    <div class="header {{narrow ? 'band-header' : ''}}">
      <div class="status-dot" style="background-color: {{statusColor}};"></div>
      <text class="status-text {{narrow ? 'band-status-text' : ''}}">{{statusText}}</text>
    </div>
    <list class="dashboard">
      <list-item type="speed" class="speed-row" style="height: {{speedHeight}}px;">
        <text class="speed {{tone}}" style="font-size: {{speedFont}}px; height: {{speedHeight}}px;">{{speed}}</text>
      </list-item>
      <list-item type="unit" class="unit-button {{narrow ? 'band-unit-button' : ''}}" onclick="changeUnit"><text class="unit {{narrow ? 'band-unit' : ''}}">{{unit}} · 切换</text></list-item>
      <list-item type="stats" class="metrics {{narrow ? 'band-metrics' : ''}}">
        <div class="metric"><text class="metric-label {{narrow ? 'band-metric-label' : ''}}">历史平均</text><text class="metric-value {{narrow ? 'band-metric-value' : ''}}">{{average}}</text></div>
        <div class="metric-divider"></div>
        <div class="metric"><text class="metric-label {{narrow ? 'band-metric-label' : ''}}">历史最高</text><text class="metric-value {{narrow ? 'band-metric-value' : ''}}">{{maximum}}</text></div>
      </list-item>
      <list-item type="summary" class="summary {{narrow ? 'band-summary' : ''}}">
        <text if="{{recordNotice}}" class="hint {{narrow ? 'band-hint' : ''}}">{{recordNotice}}</text>
        <text if="{{!recordNotice &amp;&amp; altitude !== '--'}}" class="altitude {{narrow ? 'band-altitude' : ''}}">海拔 {{altitude}} m</text>
        <text if="{{altitude !== '--' &amp;&amp; recording}}" class="record-state {{recording ? 'good' : ''}} {{narrow ? 'band-record-state' : ''}}">{{recording ? recordInfo : ''}}</text>
        <text if="{{!recordNotice &amp;&amp; altitude === '--'}}" class="hint {{narrow ? 'band-hint' : ''}}">{{recording ? recordInfo : hint}}</text>
      </list-item>
    </list>
    <div class="footer {{narrow ? 'band-footer' : ''}}">
      <div class="action primary record-action {{narrow ? 'band-action' : ''}}" onclick="toggleRecording"><text class="action-text primary-text {{narrow ? 'band-action-text' : ''}}">{{recordText}}</text></div>
      <div class="action secondary {{narrow ? 'band-action' : ''}}" onclick="openPosition"><text class="action-text {{narrow ? 'band-action-text' : ''}}">详情</text></div>
      <div class="action secondary {{narrow ? 'band-action' : ''}}" onclick="openTracks"><text class="action-text {{narrow ? 'band-action-text' : ''}}">轨迹</text></div>
    </div>
  </div>
</template>
<script>
import { createReadingPage } from '../../common/page'
export default createReadingPage()
</script>
