<template>
  <stack class="screen">
    <div class="page {{pageClass}}" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
      <div class="header {{narrow ? 'band-header' : ''}}"><text class="title {{narrow ? 'band-title' : ''}}">GPX 轨迹</text><text class="count">{{files.length}}</text></div>
      <list if="{{selectedUri}}" class="file-detail">
        <list-item type="filename" class="filename-row {{narrow ? 'band-filename-row' : ''}}"><text class="filename {{narrow ? 'band-filename' : ''}}">{{selectedName}}</text></list-item>
        <list-item type="reading" class="file-reading {{narrow ? 'band-file-reading' : ''}}"><text class="file-label {{narrow ? 'band-file-label' : ''}}">轨迹点</text><text class="file-value {{narrow ? 'band-file-value' : ''}}">{{pointCount}}</text></list-item>
        <list-item type="reading" class="file-reading {{narrow ? 'band-file-reading' : ''}}"><text class="file-label {{narrow ? 'band-file-label' : ''}}">时长</text><text class="file-value {{narrow ? 'band-file-value' : ''}}">{{duration}}</text></list-item>
        <list-item type="reading" class="file-reading {{narrow ? 'band-file-reading' : ''}}"><text class="file-label {{narrow ? 'band-file-label' : ''}}">海拔范围</text><text class="file-value {{narrow ? 'band-file-value' : ''}}">{{elevation}}</text></list-item>
        <list-item type="notice" class="notice-row {{narrow ? 'band-notice-row' : ''}}"><text class="hint {{narrow ? 'band-hint' : ''}}">{{message}}</text></list-item>
        <list-item if="{{runtimeTrace}}" type="runtime" class="runtime-row {{narrow ? 'band-runtime-row' : ''}}"><text class="runtime-text {{narrow ? 'band-runtime-text' : ''}}">{{runtimeTrace}}</text></list-item>
        <list-item type="delete" class="delete-row {{narrow ? 'band-delete-row' : ''}}">
          <div class="action delete-button {{narrow ? 'band-action' : ''}} {{narrow ? 'band-delete-button' : ''}}" onclick="deleteSelected"><text class="action-text {{narrow ? 'band-action-text' : ''}}">{{confirmDelete ? '确认删除' : '删除文件'}}</text></div>
          <div if="{{confirmDelete}}" class="action secondary cancel-button {{narrow ? 'band-action' : ''}}" onclick="cancelDelete"><text class="action-text {{narrow ? 'band-action-text' : ''}}">取消</text></div>
        </list-item>
      </list>
      <list else class="file-list">
        <list-item type="connection" class="list-message"><text class="hint {{narrow ? 'band-hint' : ''}}">{{syncStatus}}</text></list-item>
        <list-item type="empty" if="{{files.length === 0}}" class="empty"><text class="hint {{narrow ? 'band-hint' : ''}}">{{message || '暂无轨迹，点击首页的记录开始'}}</text></list-item>
        <list-item type="track" for="{{files}}" tid="uri" class="file-item {{narrow ? 'band-file-item' : ''}}" onclick="selectFile($item.uri)">
          <text class="file-name {{narrow ? 'band-file-name' : ''}}">{{$item.label}}</text>
          <text class="file-size {{narrow ? 'band-file-size' : ''}}">GPX · {{$item.size}}</text>
        </list-item>
        <list-item type="message" if="{{files.length > 0 &amp;&amp; message}}" class="list-message"><text class="hint {{narrow ? 'band-hint' : ''}}">{{message}}</text></list-item>
      </list>
      <div class="footer tracks-footer {{narrow ? 'band-footer' : ''}} {{narrow ? 'band-tracks-footer' : ''}}">
        <div class="action secondary back-button {{narrow ? 'band-action' : ''}}" onclick="back"><text class="action-text {{narrow ? 'band-action-text' : ''}}">{{selectedUri ? '返回列表' : '返回测速'}}</text></div>
        <div if="{{!selectedUri}}" class="action secondary refresh-button {{narrow ? 'band-action' : ''}}" onclick="refresh"><text class="action-text {{narrow ? 'band-action-text' : ''}}">刷新</text></div>
      </div>
    </div>
    <div if="{{screenCovered}}" class="sleep-cover" onclick="wakeScreen">
      <div class="sleep-dot" style="background-color: {{statusColor}}; left: {{sleepDotLeft}}px;"></div>
    </div>
  </stack>
</template>
<script>
import file from '@system.file'
import device from '@system.device'
import router from '@system.router'
import { screenLayout } from '../../common/layout'
import { listTracks, fileCall, assertTrackUri } from '../../common/files'
import { recoverTracks } from '../../common/recording'
import { summarizeTrack } from '../../common/track-summary'
import { createNavigation } from '../../common/navigation'

function detachPage(page) {
  if (page._visible) page._session.release(page._listener)
  page._visible = false
  for (const key of ['_unsubscribeStatus', '_unsubscribeSync']) {
    if (page[key]) { page[key](); page[key] = null }
  }
}

function clearSelection(page, message) {
  page._version += 1
  page.selectedUri = ''; page.confirmDelete = false; page.message = message
}

export default {
  private: {
    pageClass: 'round-page', narrow: false, files: [], selectedUri: '', selectedName: '',
    pointCount: '--', duration: '--', elevation: '--', runtimeTrace: '', message: '', syncStatus: '', confirmDelete: false, busy: false,
    screenCovered: false, statusColor: '#f2bf68', sleepDotLeft: 118
  },
  onInit() {
    this._destroyed = false
    this._visible = false
    this._version = 0
    this._session = this.$app.$def.session
    this._navigation = createNavigation(router, 2, this.$app.$def.clock)
    this._listener = current => {
      if (this._destroyed) return
      this.screenCovered = !!current.screenCovered
      this.statusColor = current.statusColor
      this.sleepDotLeft = current.sleepDotLeft
    }
    device.getInfo({ success: info => {
      if (this._destroyed) return
      const layout = screenLayout(info); this.pageClass = layout.pageClass; this.narrow = layout.narrow
    }, fail() {} })
  },
  onShow() {
    this._navigation.shown()
    this._visible = true; this._session.acquire(this._listener)
    const sync = this.$app.$def.trackSync
    if (sync && sync.subscribeStatus && !this._unsubscribeStatus) this._unsubscribeStatus = sync.subscribeStatus(status => {
      if (!this._destroyed) this.syncStatus = status
    })
    if (sync && !this._unsubscribeSync) this._unsubscribeSync = sync.subscribe(name => {
      const entry = this.files.filter(item => item.name === name)[0]
      if (!entry) return
      this.files = this.files.filter(item => item.name !== name)
      if (this.selectedUri === entry.uri) clearSelection(this, '文件已通过 AstroBox 删除')
      else this.message = '文件已通过 AstroBox 删除'
    })
    this.refresh()
  },
  onHide() { detachPage(this) },
  onDestroy() {
    this._destroyed = true; this._version += 1
    detachPage(this)
  },
  async refresh() {
    if (this.busy) return
    this.busy = true; this.message = '正在读取轨迹'
    try {
      const recovery = await recoverTracks(file, this._session.activeUri())
      const files = await listTracks(file)
      if (this._destroyed) return
      this.files = files; this.message = recovery.failed ? recovery.failed + ' 个未完成文件恢复失败' :
        (this._session.activeUri() ? '正在记录的轨迹结束后会出现在这里' : '')
    } catch (error) { if (!this._destroyed) this.message = error.message }
    finally { this.busy = false }
  },
  async selectFile(uri) {
    if (this.busy) return
    const entry = this.files.filter(item => item.uri === uri)[0]
    if (!entry) return
    this.selectedUri = uri; this.selectedName = entry.label; this.confirmDelete = false
    this.pointCount = '--'; this.duration = '--'; this.elevation = '--'; this.runtimeTrace = ''; this.message = '正在读取轨迹'
    const version = ++this._version
    try {
      const summary = await summarizeTrack(file, uri)
      if (this._destroyed || version !== this._version) return
      this.pointCount = String(summary.points); this.duration = summary.duration; this.elevation = summary.elevation
      this.runtimeTrace = summary.runtimeTrace
      this.message = summary.complete ? '时间按手表当前时区显示' : '文件未完整结束'
    } catch (error) { if (!this._destroyed && version === this._version) this.message = error.message }
  },
  async deleteSelected() {
    if (this.busy || !this.selectedUri) return
    if (!this.confirmDelete) { this.confirmDelete = true; this.message = '再次点击确认，只删除此文件'; return }
    const uri = this.selectedUri
    this.busy = true
    try {
      assertTrackUri(uri)
      await fileCall(file, 'delete', { uri })
      if (this._destroyed) return
      this.files = this.files.filter(item => item.uri !== uri)
      clearSelection(this, '文件已删除')
    } catch (error) { if (!this._destroyed) this.message = error.message }
    finally { this.busy = false }
  },
  cancelDelete() { this.confirmDelete = false; this.message = '' },
  back() {
    if (this.busy) return
    if (this.selectedUri) { clearSelection(this, ''); return }
    this._navigation.go(0)
  },
  wakeScreen() { this._session.interact() },
  onBackPress() { if (this.screenCovered) this.wakeScreen(); else this.back(); return true },
  onTouchStart(event) {
    if (this.screenCovered) return
    this._session.interact(); this._navigation.start(event)
  },
  onTouchMove(event) {
    if (this.screenCovered) return
    this._session.interact(); this._navigation.move(event)
  },
  onTouchEnd(event) {
    if (!this._destroyed && this._visible && !this.busy && !this.screenCovered) {
      this._session.interact(); this._navigation.end(event)
    }
  }
}
</script>
<style lang="less">
@import '../../common/page.less';
.title { font-size: 16px; font-weight: bold; color: #edf4fa; }
.count { font-size: 12px; color: #7ef7c5; margin-left: 8px; }
.file-list { flex: 1; width: 100%; }
.file-item { width: 100%; height: 56px; flex-direction: column; justify-content: center; border-bottom-width: 1px; border-color: #263b46; }
.file-name { font-size: 14px; color: #edf4fa; lines: 2; }
.file-size { font-size: 11px; color: #96aeb8; }
.empty { height: 110px; align-items: center; justify-content: center; }
.list-message { height: 34px; }
.file-detail { flex: 1; width: 100%; }
.filename-row { width: 100%; height: 30px; align-items: center; }
.notice-row { width: 100%; height: 28px; align-items: center; }
.runtime-row { width: 100%; height: 120px; align-items: center; }
.runtime-text { width: 100%; font-size: 11px; color: #96aeb8; lines: 8; }
.filename { width: 100%; font-size: 11px; color: #96aeb8; lines: 2; }
.file-reading { width: 100%; height: 30px; align-items: center; justify-content: space-between; }
.file-label { color: #96aeb8; font-size: 11px; }
.file-value { color: #edf4fa; font-size: 16px; font-weight: bold; }
.delete-row { width: 100%; height: 30px; margin-top: 6px; justify-content: center; }
.delete-button { width: 88px; height: 28px; background-color: #622c35; }
.cancel-button { width: 58px; height: 28px; margin-left: 6px; }
.tracks-footer { height: 28px; justify-content: center; }
.back-button { width: 100px; height: 28px; }
.refresh-button { width: 58px; height: 28px; margin-left: 8px; }
.band-title { font-size: 24px; }
.band-file-item { height: 98px; }
.band-file-name { font-size: 21px; }
.band-file-size { font-size: 17px; }
.band-filename { font-size: 17px; }
.band-filename-row { height: 52px; }
.band-notice-row { height: 56px; }
.band-runtime-row { height: 200px; }
.band-runtime-text { font-size: 17px; }
.band-file-reading { height: 70px; flex-direction: column; justify-content: center; }
.band-file-label { font-size: 18px; }
.band-file-value { font-size: 26px; }
.band-delete-row { height: 104px; flex-direction: column; align-items: center; }
.band-delete-button { height: 44px; }
.band-tracks-footer { height: 104px; }
</style>
