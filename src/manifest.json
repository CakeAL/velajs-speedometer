{
  "package": "com.cakeal.speedometer",
  "name": "速度计",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "minAPILevel": 1,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.geolocation"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.brightness"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.file"
    },
    {
      "name": "system.storage"
    }
  ],
  "permissions": [
    { "name": "hapjs.permission.LOCATION" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 240,
    "background": {
      "features": ["system.geolocation"]
    }
  },
  "display": {
    "backgroundColor": "#080d12"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/position": {
        "component": "position"
      },
      "pages/tracks": {
        "component": "tracks"
      }
    }
  }
}
